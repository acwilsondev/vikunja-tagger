# Base URL of your Vikunja instance's API (no trailing /api/v1)
VIKUNJA_URL=https://vikunja.example.com

# A Vikunja personal API token with read access to labels and write access
# to tasks. Create one under Vikunja > Settings > API Tokens.
VIKUNJA_API_TOKEN=changeme

# Shared secret configured on the Vikunja webhook (Project > Webhooks).
# Vikunja HMAC-SHA256-signs the raw request body with this and sends the
# hex digest in the X-Vikunja-Signature header.
WEBHOOK_SECRET=changeme

# Ollama server reachable from wherever this worker runs.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
